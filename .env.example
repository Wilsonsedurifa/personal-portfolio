# STEP 1: Copy this file to .env in this same folder (flask_project).
# The app reads .env, NOT .env.example. Never commit real credentials.
#
# STEP 2: Paste your PostgreSQL provider's COMPLETE connection URL after =.
# Keep it on ONE line, with no spaces around =.
# Format (example only -- replace ALL uppercase placeholders):
# DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require
#
# USERNAME      = database user (not your portfolio admin username)
# PASSWORD      = database password (not your portfolio admin password)
# HOST          = database server address from your provider
# 5432          = port; use the provider's port if different
# DATABASE_NAME = database name from your provider
#
# Prefer copying the provider's connection string exactly, including its SSL
# options. If building it yourself, URL-encode special characters in the password:
# @ becomes %40, # becomes %23, and / becomes %2F. Do not double-encode a copied URL.
# Leave the value below EMPTY only if you want local SQLite instead of PostgreSQL.
DATABASE_URL=postgresql://USERNAME:1234@HOST:5432/DATABASE_NAME?sslmode=require

# STEP 3: Generate a random key with this terminal command and paste its output:
# python -c "import secrets; print(secrets.token_hex(32))"
# Keep this value stable; changing it signs out existing sessions.
SECRET_KEY=8c3792a537e3c946029221e99e4a6d3e1eece8b5da0b6c565ae01d66f8587b2e

# STEP 4: Keep 0 while setting up PostgreSQL. Run migrations explicitly:
# Existing data -> empty PostgreSQL: python -m flask --app app import-sqlite instance/portfolio.sqlite
# Then apply schema updates:        python -m flask --app app init-db
# Fresh database instead: skip import-sqlite and run init-db, then create-admin.
AUTO_INIT_DB=0
